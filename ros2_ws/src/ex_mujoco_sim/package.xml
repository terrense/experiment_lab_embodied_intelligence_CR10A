<?xml version="1.0"?>
<package format="3">
  <name>ex_mujoco_sim</name>
  <version>0.1.0</version>
  <description>EMBODIED-X M4: MuJoCo physics plant for the CR10A behind ros2_control (topic_based_ros2_control). SIMULATION ONLY. Requires the `mujoco` Python package (scripts/setup_mujoco.sh).</description>
  <maintainer email="slamshenxin@gmail.com">embodied-x</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>ex_description</exec_depend>
  <exec_depend>topic_based_ros2_control</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
