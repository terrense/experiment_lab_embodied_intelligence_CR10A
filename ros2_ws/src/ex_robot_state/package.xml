<?xml version="1.0"?>
<package format="3">
  <name>ex_robot_state</name>
  <version>0.1.0</version>
  <description>EMBODIED-X robot state pipeline: mock source, validating JointState adapter, read-only Dobot feedback observer, monitor/HUD, pipeline checks. ROS-free core in ex_robot_state.core.</description>
  <maintainer email="slamshenxin@gmail.com">embodied-x</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
